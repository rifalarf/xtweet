# Salin file ini ke .streamlit/secrets.toml dan isi dengan nilai yang sebenarnya.
# JANGAN commit secrets.toml ke repository.
#
# Di Streamlit Community Cloud, masukkan nilai-nilai ini lewat menu
# App Settings → Secrets (tanpa membuat file secrets.toml secara manual).

X_CONSUMER_KEY       = "isi_consumer_key_kamu"
X_CONSUMER_SECRET    = "isi_consumer_secret_kamu"
X_ACCESS_TOKEN       = "isi_access_token_kamu"
X_ACCESS_TOKEN_SECRET = "isi_access_token_secret_kamu"
GOOGLE_API_KEY       = "isi_google_ai_api_key_kamu"
